{
  "name": "@react-email/scss-plugin",
  "version": "6.9.5",
  "description": "esbuild plugin that compiles SCSS modules for React Email templates",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "css-tree": "^3.1.0",
    "sass": "^1.93.0"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.10",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "esbuild": ">=0.19"
  }
}
